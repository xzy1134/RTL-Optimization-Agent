# 复制为项目根目录的 .env，在本地编辑密钥；.env 已被 Git 忽略。
# 优先级：命令行模型/地址 > .env > 环境变量 > 默认值。
# 只支持 KEY=VALUE，可使用成对引号；不执行 Shell 或变量替换。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# 兼容老师旧 .env 的 LLM_API_KEY 和 LLM_MODEL。
# 不使用 LLM_BASE_URL：老师的 /anthropic 地址属于另一种协议。
